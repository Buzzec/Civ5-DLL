set(CIV5_DEPENDENCIES_DIR "" CACHE PATH "Optional existing Community-Patch-DLL checkout (otherwise fetched)")
if(NOT CIV5_DEPENDENCIES_DIR)
    find_package(Git REQUIRED)
    set(dependency_root "${CMAKE_CURRENT_BINARY_DIR}/_deps/community-patch")
    set(dependency_commit aefacbf1b24a27aa42dc50b4283420a999f7fded)
    function(dependency_git)
        execute_process(COMMAND "${GIT_EXECUTABLE}" ${ARGV}
            WORKING_DIRECTORY "${dependency_root}" RESULT_VARIABLE result)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Dependency Git operation failed (${result}). Retry configuration or set CIV5_DEPENDENCIES_DIR to an existing checkout.")
        endif()
    endfunction()
    if(NOT EXISTS "${dependency_root}/.ready-${dependency_commit}")
        message(STATUS "Fetching pinned Civ5 support headers and x86 libraries...")
        file(MAKE_DIRECTORY "${dependency_root}")
        if(NOT EXISTS "${dependency_root}/.git")
            dependency_git(init)
            dependency_git(remote add origin https://github.com/LoneGazebo/Community-Patch-DLL.git)
        endif()
        dependency_git(sparse-checkout init --cone)
        dependency_git(sparse-checkout set CvGameCoreDLLUtil CvGameDatabase
            CvLocalization CvWorldBuilderMap FirePlace ThirdPartyLibs Lua_51)
        dependency_git(fetch --depth=1 --filter=blob:none origin "${dependency_commit}")
        dependency_git(checkout --detach "${dependency_commit}")
        file(WRITE "${dependency_root}/.ready-${dependency_commit}" "${dependency_commit}\n")
    endif()
    set(CIV5_DEPENDENCIES_DIR "${dependency_root}")
endif()
